# Base de données
#
# ⚠️ L'hôte dans DATABASE_URL dépend du mode de déploiement :
#   - Dev (service systemd sur le serveur de dev, DB en container Docker avec port
#     publié sur l'hôte) : host = "localhost" (ex ci-dessous)
#   - Prod (API elle-même en container Docker, via docker-compose.prod.yml) :
#     host = nom du service Compose de la DB (ex "db"), PAS "localhost" — depuis
#     un container, "localhost" désigne le container lui-même, pas le voisin.
#     Exemple prod : DATABASE_URL=postgresql://gmao_user:password@db:5432/gmao_db
DATABASE_URL=postgresql://gmao_user:password@localhost:5432/gmao_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT souverain
JWT_SECRET_KEY=your-very-long-random-secret-key-here-minimum-32-chars

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# Mail (optionnel — MAIL_ENABLED=false pour désactiver)
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=tunnel@example.com
SMTP_PASSWORD=secret
SMTP_FROM=tunnel@example.com
SMTP_FROM_NAME=Tunnel GMAO
SMTP_STARTTLS=true

# API
API_ENV=production
AUTH_DISABLED=false
FRONTEND_URL=http://localhost:5173

# Variables Directus supprimées en v3.0.0 :
# DIRECTUS_URL — plus utilisé (auth souveraine)
# DIRECTUS_KEY — jamais utilisé
# DIRECTUS_SECRET — remplacé par JWT_SECRET_KEY
